*.opensdf
*.VC.db
*.VC.opendb
.cache/

# Unshipped port and reference trees -----------------------------------------
# phonon/ *is* shipped: src/phonon_engine.odin imports it and it is the default
# ASR path for phonon models, so it is tracked like src/. Only the Rust port and
# the reference trees are scaffolding.
/phonon-rs-master/
/reference/
/vendor_src/

