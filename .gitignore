# =============================================================================
# What this repo ships: the sources needed to build hex.exe.
#   src/                     Odin app (13 files)
#   native/CMakeLists.txt    + transcribe_shim.{cpp,h}
#   build.ps1                + scripts/make-icon.py (regenerates hex.res)
#   Hex.png                  icon source
#   README.md
# Everything else is local scaffolding: ports, benchmarks, probes, captures,
# generated artifacts. No upstream PRs for now, so none of it is worth pushing.
# =============================================================================

# Build output ---------------------------------------------------------------
# build.ps1 writes the exe, its PDB, the icon intermediates and the shim here.
/bin/
*.exe
*.pdb
*.o
*.obj
*.lib
*.a
*.dll
*.so
*.dylib
*.exp
*.ilk
*.ll
*.map
*.res
*.bin

# Native shim and cmake trees (built by scripts/build-native.ps1) ------------
/native/build/
/native/build-*/
/native/bin/
/native/third_party/
/native/transcribe_shim.dll
/transcribe_shim.dll

